$installer = "C:\Temp\${installer_filename}"
New-Item -ItemType Directory -Path (Split-Path $installer) -Force | Out-Null
Read-S3Object -BucketName "${bucket_name}" -Key "${object_key}" -File $installer -Region "${region}"

# The installer does not exit on its own - it keeps running as a supervisor
# process that spawns worker processes indefinitely. So we launch it without
# waiting for exit, and instead poll the registration marker it writes to the
# registry (the same way the vendor's own install script checks success).
Start-Process -FilePath $installer

$registrationKeys = @(
    ${registration_keys_ps}
)
$maxRetry = 30
$registered = $false
for ($i = 0; $i -lt $maxRetry; $i++) {
    foreach ($key in $registrationKeys) {
        $prop = Get-ItemProperty -Path $key -Name ${registration_value_name} -ErrorAction SilentlyContinue
        if ($prop -and $prop.${registration_value_name} -eq 1) {
            $registered = $true
            break
        }
    }
    if ($registered) { break }
    Start-Sleep -Seconds 10
}

if ($registered) {
    Write-Host "Sensor agent registered successfully."
} else {
    Write-Host "Sensor agent did not report registration within the timeout - continuing anyway."
}
